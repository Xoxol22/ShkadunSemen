{
  "name": "vizprog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint \"src/itogzd/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/itogzd/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/itogzd/**/*.{ts,tsx,css,json}\"",
    "test": "vitest",
    "test:run": "vitest run src/itogzd/store/slices/__tests__",
    "ci": "npm run lint && npm run format:check && npm run test:run"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.59.3",
    "vite": "^5.4.21",
    "vitest": "^4.1.5"
  }
}
